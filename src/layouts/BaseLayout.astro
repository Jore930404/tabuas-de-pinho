---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getContent, site, whatsappLink, type Lang } from '../data/content';
import '../styles/global.css';

interface Props {
  lang: Lang;
  path: string;
  alternatePath: string;
}

const { lang, path, alternatePath } = Astro.props;
const t = getContent(lang);
const base = Astro.site ?? new URL('https://tabuasdepinho.com.br');
const canonical = new URL(path, base).href;
const alternate = new URL(alternatePath, base).href;
const ptHref = new URL('/', base).href;
const ogImage = new URL(site.ogImage, base).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FurnitureStore',
  '@id': `${canonical}#atelier`,
  name: site.fullName,
  description: t.meta.description,
  url: canonical,
  image: ogImage,
  telephone: `+${site.phoneRaw}`,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postal,
    addressCountry: site.address.country,
  },
  areaServed: [
    { '@type': 'City', name: 'Ponta Grossa' },
    { '@type': 'AdministrativeArea', name: 'Campos Gerais, Paraná' },
  ],
  sameAs: [site.facebook, site.tiktok],
};
---

<!doctype html>
<html lang={t.htmlLang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'pt' ? 'pt-BR' : 'es'} href={canonical} />
    <link rel="alternate" hreflang={lang === 'pt' ? 'es' : 'pt-BR'} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={ptHref} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F7F0E2" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'es_AR'} />
    <meta property="og:locale:alternate" content={lang === 'pt' ? 'es_AR' : 'pt_BR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600&family=Inter:wght@400;500;600&display=swap"
    />

    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{t.a11y.skip}</a>
    <Header lang={lang} t={t} />
    <slot />
    <Footer lang={lang} t={t} />
    <a
      class="wa-float"
      href={whatsappLink(t.contact.whatsappMessage)}
      target="_blank"
      rel="noopener"
      aria-label={t.a11y.whatsapp}
    >
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12.04 2a9.87 9.87 0 0 0-8.5 14.88L2 22l5.27-1.5A9.87 9.87 0 1 0 12.04 2Zm0 17.9a8 8 0 0 1-4.08-1.12l-.29-.17-3.13.89.9-3.05-.19-.31a8.02 8.02 0 1 1 6.79 3.76Zm4.4-5.99c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06a6.53 6.53 0 0 1-1.92-1.18 7.2 7.2 0 0 1-1.33-1.65c-.14-.24 0-.37.1-.49.1-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"
        ></path>
      </svg>
    </a>
    <script>
      const waFloat = document.querySelector('.wa-float');
      const updateWaFloat = () => {
        waFloat?.classList.toggle('is-visible', window.scrollY > 420);
      };
      updateWaFloat();
      window.addEventListener('scroll', updateWaFloat, { passive: true });
    </script>
  </body>
</html>
